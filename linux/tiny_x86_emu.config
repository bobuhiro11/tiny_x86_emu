# Minimal 32bit x86 kernel for tiny_x86_emu: serial console, initramfs, no PCI,
# no APIC (the classic PIC + PIT timer path), no SMP.
CONFIG_64BIT=n
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_M686=y
CONFIG_SMP=n
CONFIG_X86_UP_APIC=n
CONFIG_X86_MPPARSE=n
CONFIG_PCI=n
CONFIG_ACPI=n
CONFIG_HPET_TIMER=n
CONFIG_X86_PM_TIMER=n
CONFIG_X86_PAE=n
CONFIG_NOHIGHMEM=y
CONFIG_MATH_EMULATION=n
CONFIG_MICROCODE=n
CONFIG_HZ_100=y
CONFIG_KERNEL_GZIP=y
CONFIG_MODULES=n

# console
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_8250_PNP=n
CONFIG_VT=n
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y

# userland
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_ELF_CORE=n

# Go's 32bit runtime calls the old futex syscall, which needs the 32bit time_t
# system calls
CONFIG_COMPAT_32BIT_TIME=y
